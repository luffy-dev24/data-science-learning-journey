import pandas as pd


df = pd.read_csv("streaming_viewership_raw.csv")


df_copy = df


sorted_df = df_copy.sort_values("user_age" , ascending=False)


sorted_df.reset_index(drop=True , inplace=True)


sorted_df


sorted_df["rank"] = sorted_df["user_rating"].rank()


sorted_df


sorted_df["rank"] = sorted_df["user_rating"].rank(method="dense")


sorted_df



