import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns


df_raw = pd.read_csv("1_missing_values.csv")


df = df_raw.copy()


df


df["score"] = df["score"].fillna(df["score"].mean())


df["attendance"] = df["attendance"].fillna(df["attendance"].mean())


df


total_avg_by_subjects = df.groupby("subject")["score"].mean()


x = np.arange(len(total_avg_by_subjects))

sns.barplot(x=total_avg_by_subjects.index , y=total_avg_by_subjects.values , color="orange")
plt.xlabel("subjects")
plt.ylabel("average score")
plt.title("average score comparision by subjects")

for i in range(len(total_avg_by_subjects)):
    plt.text(x[i] , total_avg_by_subjects.values[i]+0.3 , str(int(total_avg_by_subjects.values[i])))
    
plt.show()


df


plt.hist(df.query("subject == 'Math' ").loc[:,"score"].values ,bins=3,edgecolor="black")
plt.xlabel("scores")
plt.ylabel("frequency")
plt.title("scores distribution of math subject")
plt.show()


science_scores = df.query(" subject == 'Science' ").loc[:,"score"].values
science_scores

plt.hist(science_scores , bins=2 , edgecolor="black")
plt.xlabel("scores")
plt.ylabel("frequency")
plt.title("scores distribution of science subject")
plt.show()


english_scores = df.query("subject == 'English' ").loc[:,"score"].values

plt.hist(english_scores,bins=2,edgecolor="black")
plt.xlabel("scores")
plt.ylabel("frequency")
plt.title("scores distribution of english subject")
plt.show()



